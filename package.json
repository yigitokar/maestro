{
  "name": "maestro-workflows",
  "version": "1.3.1",
  "description": "Multi-agent workflow orchestrator: a deterministic script drives clean-context agents",
  "type": "module",
  "license": "Apache-2.0",
  "homepage": "https://docs.careresearch.ai/maestro",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yigitokar/maestro.git"
  },
  "bugs": "https://github.com/yigitokar/maestro/issues",
  "keywords": [
    "agents",
    "multi-agent",
    "workflow",
    "orchestrator",
    "claude",
    "codex",
    "mcp"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.18"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "maestro": "bin/maestro"
  },
  "files": [
    "dist",
    "bin",
    "skill",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage --coverage.include='src/**'",
    "lint": "biome check . && tsc -p tsconfig.json --noEmit",
    "format": "biome check --write .",
    "smoke": "npm run build && node examples/smoke.ts",
    "prepublishOnly": "npm run lint && npm run build && npm test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "acorn": "^8.19.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.1.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
